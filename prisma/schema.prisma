// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ROLE {
  user
}

enum StatusInvoice {
  pending
  paid
  overdue
}

enum StatusQueueCategory {
  urgent
  pending
  onTime
}

model User {
  id       Int       @id @default(autoincrement())
  nama     String
  email    String?   @unique
  password String
  role     ROLE      @default(user)
  invoices Invoice[]
}

model Invoice {
  id          Int           @id @default(autoincrement())
  client_nama String?
  total       Int
  paid        Int
  status      StatusInvoice @default(pending)
  amount      Int
  date        DateTime
  dueDate     DateTime
  CreateAt    DateTime      @default(now())
  UpdateAt    DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  userId      Int
  queues      Queue[]
  histories   history[]
}

model InvoiceTheme {
  id Int @id @default(autoincrement())
}

model Queue {
  id            Int     @id @default(autoincrement())
  total_pending Int
  overdue       Int
  total_amount  Int
  invoice       Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId     Int
}

model QueueCategory {
  id     Int                 @id @default(autoincrement())
  status StatusQueueCategory @default(pending)
}

model history {
  id             Int     @id @default(autoincrement())
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId      Int
  totalEvent     Int
  payment_method Int
  overdue        Int
}
