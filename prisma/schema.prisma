generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model history {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  total_event    Int
  payment_method Int
  overdue        Int
  invoices       invoice @relation(fields: [invoiceId], references: [id])
  user           user    @relation(fields: [userId], references: [id])
  userId         Int
}

model invoice {
  id         Int            @id @default(autoincrement())
  clientNama String
  amount     Int
  date       DateTime
  dueData    DateTime
  status     invoice_status
  histories  history[]
  user       user           @relation(fields: [userId], references: [id])
  queue      queue[]
  userId     Int
}

model queue {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  total_pending Int
  overdue       Int
  total_amount  Int
  invoice       invoice @relation(fields: [invoiceId], references: [id], map: "Queue_invoiceId_fkey")

  @@index([invoiceId], map: "Queue_invoiceId_fkey")
}

model queuecategory {
  id     Int                  @id @default(autoincrement())
  status queuecategory_status @default(pending)
}

model user {
  id        Int       @id @default(autoincrement())
  nama      String
  email     String?   @unique(map: "User_email_key")
  password  String
  role      user_role @default(user)
  invoices  invoice[]
  histories history[]
}

enum queuecategory_status {
  urgent
  pending
  onTime
}

enum user_role {
  user
}

enum invoice_status {
  paid
  pending
  overide
}
